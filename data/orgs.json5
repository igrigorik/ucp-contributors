  // Pseudo-orgs. Same code path, explicitly not companies.
  //
  //   (absent from contributors.json5) = nobody has looked yet
  //   independent                      = looked; personal capacity
  //   undisclosed                      = looked; no public affiliation found
  //   bot                              = automation, excluded from people counts
  independent: { name: "Independent" },
  undisclosed: { name: "Undisclosed" },
  bot:         { name: "Automation" },
